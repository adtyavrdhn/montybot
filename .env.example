DATABASE_URL=postgresql://sammy:sammy@127.0.0.1:5432/sammy
# Any long random string: `python -c "import secrets; print(secrets.token_urlsafe(32))"`
SESSION_SECRET=change-me
# 32 bytes, base64url: `uv run python -c "from sammy.crypto import new_key; print(new_key())"`
ENCRYPTION_KEY=
# A Pydantic AI model name. `claude-code:NAME` runs on a Claude Code subscription: sign in once with
# `uv run sammy claude-code-login` (see sammy/vendor/README.md). Other providers read their key from the
# environment, for example ANTHROPIC_API_KEY.
MODEL=claude-code:claude-opus-5-5
# Where the Claude Code tokens live: `file` on a server (on a persistent, writable volume), `auto` for the OS keyring.
# CLAUDE_CODE_CREDENTIALS=file
# CLAUDE_CODE_AUTH_FILE=/data/claude-code/auth.json
# The hosted Monty sandboxes the agent's code runs in; the key is sent as `Authorization: Bearer`.
MONTY_URL=wss://monty-sdk-test-hqjw53u6ua-uk.a.run.app/monty-ws/
MONTY_EXECUTION_KEY=
# Our own Full Monty instead (`docker compose --profile full-monty up -d`):
# MONTY_URL=ws://127.0.0.1:8100
# Unset MONTY_URL to run Monty in local subprocesses.

# Legacy experimental Jev settings. Production agent runs ignore these.
TYPESAFE_API_KEY=
JEV_MODEL=jev-latest
JEV_THRESHOLD=0.8
LOGFIRE_TOKEN=
# Integrations: one-click apps (Linear, GitHub, Gmail...) through Composio. Unset: users can still add MCP servers.
# COMPOSIO_API_KEY=
# Each user is <prefix><user id> in Composio; give each app or deployment sharing a Composio project its own prefix.
# COMPOSIO_USER_PREFIX=sammy:
# Web search and page reading without the browser. A model with its own web tools (Anthropic, OpenAI, Google) uses
# them; set NATIVE_WEB_TOOLS=false to always use Sammy's. Sammy's web_search needs a Tavily key; unset, a model without
# its own search searches in the browser. Sammy's web_fetch needs nothing.
# NATIVE_WEB_TOOLS=true
# TAVILY_API_KEY=
