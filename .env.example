DATABASE_URL=postgresql://montybot:montybot@127.0.0.1:5432/montybot
# Any long random string: `python -c "import secrets; print(secrets.token_urlsafe(32))"`
SESSION_SECRET=change-me
# 32 bytes, base64url: `uv run python -c "from montybot.crypto import new_key; print(new_key())"`
ENCRYPTION_KEY=
# A Pydantic AI model name. `claude-code:NAME` runs on a Claude Code subscription: sign in once with
# `uv run montybot claude-code-login` (see montybot/vendor/README.md). Other providers read their key from the
# environment, for example ANTHROPIC_API_KEY.
MODEL=claude-code:claude-opus-5-5
# Where the Claude Code tokens live: `file` on a server (on a persistent, writable volume), `auto` for the OS keyring.
# CLAUDE_CODE_CREDENTIALS=file
# CLAUDE_CODE_AUTH_FILE=/data/claude-code/auth.json
# Full Monty from `docker compose up`; unset runs Monty in local subprocesses.
MONTY_URL=ws://127.0.0.1:8100

# Optional Jev decision advice. Off unless enabled AND a key exists.
TYPESAFE_API_KEY=
JEV_ENABLED=false
JEV_MODEL=jev-latest
JEV_THRESHOLD=0.8
LOGFIRE_TOKEN=
